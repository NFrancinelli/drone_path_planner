<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>px4_state_bridge</name>
  <version>0.1.0</version>
  <description>Bridges PX4 and ROS state: PX4 odometry to ROS odometry/TF/markers (ENU/FLU), and a ground-truth pose to PX4 as external vision (simulated motion capture).</description>
  <maintainer email="francinelli.nicolas@gmail.com">Nicolas Francinelli</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_server</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
