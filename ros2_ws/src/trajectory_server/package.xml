<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>trajectory_server</name>
  <version>0.1.0</version>
  <description>Streams smooth trajectories to PX4 in offboard mode and holds position when none is active.</description>
  <maintainer email="francinelli.nicolas@gmail.com">Nicolas Francinelli</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>drone_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
