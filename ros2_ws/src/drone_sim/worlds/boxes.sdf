<?xml version="1.0" encoding="UTF-8"?>
<!-- A few static boxes around the figure-eight test area (drone starts at the origin facing +x). -->
<sdf version="1.9">
  <world name="boxes">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 50 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.3 0.6 -0.8</direction>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>7.0 0.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 8.0 3.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 8.0 3.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_ne">
      <static>true</static>
      <pose>5.0 3.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 1.5 2.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.5 2.0</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_se">
      <static>true</static>
      <pose>5.0 -3.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 4.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 4.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_north">
      <static>true</static>
      <pose>0.0 5.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 1.5 1.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 1.5 1.5</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_west">
      <static>true</static>
      <pose>-5.0 -2.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 4.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 4.0</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
