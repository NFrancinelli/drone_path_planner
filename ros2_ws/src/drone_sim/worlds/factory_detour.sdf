<?xml version="1.0" encoding="UTF-8"?>
<!-- factory_detour: the factory hall's walls, empty but for a divider across it at x = 10
     (drone starts at the origin facing +x). For the unknown-cost comparison, the mirror of
     factory_blocked: there the unexplored way is a dead end, here it's a shortcut.
     Top view, x east, y north:
       - the divider runs from y = -7.4 to 5, 5 m tall (above the planner's 4 m ceiling);
       - north door, y = 5..9.2: the camera sees the divider's north end from x = 4 on, so
         flying to (19.5, 0) the drone goes round it;
       - south door, y = -9.2..-7.4 (1.8 m): out of the camera's view (87 deg, 10 m) on the
         way there, so flying back to (6, -7.5) the drone either returns the way it knows,
         through the north door (~28 m), or gambles on the unseen part of the divider and
         finds the south door (~17 m).
     Keep the hall identical to factory.sdf. -->
<sdf version="1.9">
  <world name="factory_detour">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 50 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.3 0.6 -0.8</direction>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Hall: 5 m walls, no roof. -->
    <model name="hall_west">
      <static>true</static>
      <pose>-3.35 0 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 19 5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 19 5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="hall_east">
      <static>true</static>
      <pose>21.85 0 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 19 5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 19 5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="hall_north">
      <static>true</static>
      <pose>9.25 9.35 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>25.5 0.3 5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>25.5 0.3 5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="hall_south">
      <static>true</static>
      <pose>9.25 -9.35 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>25.5 0.3 5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>25.5 0.3 5</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Divider: north door y = 5..9.2, south door y = -9.2..-7.4. -->
    <model name="divider">
      <static>true</static>
      <pose>10 -1.2 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 12.4 5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 12.4 5</size></box></geometry>
          <material><ambient>0.35 0.45 0.6 1</ambient><diffuse>0.35 0.45 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
